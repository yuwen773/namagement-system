# ================================
# Django 环境配置示例
# ================================
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件包含敏感信息，不应提交到版本控制

# ================================
# Django 基础配置
# ================================
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-with-python-manage-py-generate-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# ================================
# 数据库配置 (MySQL)
# ================================
DB_NAME=heritage_db
DB_USER=root
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# ================================
# CORS 配置
# ================================
# 生产环境应指定具体域名，如：http://example.com,https://example.com
# 开发环境可使用：* （不推荐用于生产）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ================================
# JWT 配置
# ================================
# Access Token 有效期（小时）
JWT_ACCESS_TOKEN_LIFETIME_HOURS=2
# Refresh Token 有效期（天）
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
